newmtl GT_MC_Ads_2
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ni 1.450000
d 1.000000
illum 2
map_Kd C:/GT_MC_Ads 2_BaseColor.png
map_Ns C:/GT_MC_Ads 2_Roughness.png
map_refl C:/GT_MC_Ads 2_Metallic.png
map_Ke C:/GT_MC_Ads 2_Emission.png
