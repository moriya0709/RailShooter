newmtl GT_MC_Elevator
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ni 1.450000
d 1.000000
illum 2
map_Kd ../Textures/1K/GT_MC_Elevator_BaseColor.png
map_Ns ../Textures/1K/GT_MC_Elevator_Roughness.png
map_refl ../Textures/1K/GT_MC_Elevator_Metallic.png
